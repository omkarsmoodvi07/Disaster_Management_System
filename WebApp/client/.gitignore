# dependencies (ignores node_modules in both client and backend)
node_modules/
.pnp
.pnp.js

# testing
coverage/

# production (targets the React build folder)
client/build/

# misc
.DS_Store

# environment variables (ensures no secret keys are uploaded from anywhere)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
client/.env

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*